{
  "name": "Littlestar Studio",
  "short_name": "Littlestar",
  "description": "A beginner-friendly programming language with 163+ built-in functions. Write, run, and share code offline.",
  "start_url": "app.html",
  "scope": "./",
  "id": "littlestar-studio",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0F0F1E",
  "theme_color": "#F5A623",
  "lang": "en",
  "dir": "ltr",
  "categories": ["education", "developer", "productivity"],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New File",
      "short_name": "New",
      "description": "Create a new Littlestar file",
      "url": "app.html?action=new",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Open Tutorial",
      "short_name": "Docs",
      "description": "Open the tutorial",
      "url": "tutorial.html",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Load Example",
      "short_name": "Examples",
      "description": "Browse 60+ examples",
      "url": "app.html?examples=true",
      "icons": [{ "src": "icon-192.png", "sizes": "192x192" }]
    }
  ],
  "file_handlers": [
    {
      "action": "app.html",
      "accept": {
        "text/plain": [".lstar", ".txt"]
      },
      "icons": [{ "src": "icon-192.png", "sizes": "192x192", "type": "image/png" }],
      "launch_type": "single-client"
    }
  ],
  "share_target": {
    "action": "app.html",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+littlestar",
      "url": "app.html?code=%s"
    }
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "edge_side_panel": {
    "preferred_width": 480
  },
  "handle_links": "preferred",
  "prefer_related_applications": false
}
